+  const hasTrustedApproverDevice = approval?.hasTrustedApproverDevice !== false;
+  const managerHelpReason = approval?.deviceStatus === "suspicious"
+    ? "這次登入需要再確認，為了保護帳號安全，請由最高管理者協助處理。"
