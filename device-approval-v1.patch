+      else if (action === "approve_self" || action === "approve_admin") setMessage("已允許這台裝置使用系統。 ");
+      else setMessage("這筆裝置申請已完成處理。 ");
+    } catch (error) {
+      setMessage("目前無法完成確認，請稍後再試。 ");
+    } finally {
+      setActionKey("");
+    }
+  };
+
+  return (
+    <div
