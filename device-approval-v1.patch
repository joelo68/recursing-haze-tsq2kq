+    if (!alreadyPending) {
+      adjustPendingSummariesInTransaction({
+        transaction,
+        db,
+        brandId,
+        accountKey,
+        delta: 1,
+        inboxSnap,
+        brandSnap,
+        latest: {
+          latestRequestId: requestId,
+          latestUserName: userName,
+          latestRole: roleId,
