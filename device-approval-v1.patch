+        brandLabel: getBrandLabel(brandId),
+        role: roleId,
+        accountId,
+        accountKey,
+        userName,
+        requestId,
+        deviceId: deviceInfo.deviceId,
+        deviceShort: deviceInfo.deviceShort,
+        device: deviceInfo.device,
+        browser: deviceInfo.browser,
+        os: deviceInfo.os,
+        loginLocation,
+        message: `${userName} 有一台新裝置等待確認`,
