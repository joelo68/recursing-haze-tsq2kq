{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.activity-sales.indexes.json"
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions"
    }
  ],
  "emulators": {
    "functions": {
      "port": 5501
    },
    "firestore": {
      "port": 8180
    },
    "auth": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4400
    },
    "singleProjectMode": true
  }
}
