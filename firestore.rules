rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 目前專案採匿名登入／自訂 Token 混合架構，因此 Rules 先負責：
    // 1. 代理資料結構驗證；2. 禁止硬刪；3. 禁止代理取得正式組織修改權限。
    // 真正的職級不可只信任前端欄位；日後若改用 Custom Claims，可再把 director/master 改為伺服器身分驗證。
    function validDelegation(data) {
      return data.keys().hasAll([
          'schemaVersion', 'type', 'principalRole', 'principalId', 'principalName',
          'delegateRole', 'delegateId', 'delegateName', 'scopeMode', 'storeNames',
          'principalStoreSnapshot', 'startDate', 'endDate', 'status', 'permissions',
          'updatedByRole'
        ])
        && data.schemaVersion == 'delegation-v1'
        && data.type in ['regional_manager', 'store_manager']
        && data.principalRole in ['manager', 'store']
        && data.delegateRole == data.principalRole
        && data.principalId is string
        && data.principalName is string
        && data.delegateId is string
        && data.delegateName is string
        && data.principalId.size() > 0
        && data.delegateId.size() > 0
        && data.principalId != data.delegateId
        && data.scopeMode in ['all_assigned_stores', 'selected_stores']
        && data.storeNames is list
        && (data.scopeMode != 'selected_stores' || data.storeNames.size() > 0)
        && data.principalStoreSnapshot is list
        && data.startDate is string
        && data.endDate is string
        && data.startDate.size() == 10
        && data.endDate.size() == 10
        && data.startDate <= data.endDate
        && data.status in ['active', 'scheduled', 'ended', 'cancelled']
        && data.permissions is map
        && data.permissions.keys().hasAll([
          'viewOperations', 'editReports', 'editHistory', 'deleteReports',
          'receiveAlerts', 'manageTasks', 'editTargets', 'editOrganization'
        ])
        && data.permissions.viewOperations is bool
        && data.permissions.editReports is bool
        && data.permissions.editHistory is bool
        && data.permissions.deleteReports is bool
        && data.permissions.receiveAlerts is bool
        && data.permissions.manageTasks is bool
        && data.permissions.editTargets is bool
        && data.permissions.editOrganization is bool
        && data.permissions.editOrganization == false
        && data.updatedByRole in ['director', 'master'];
    }

    // 品牌與 legacy 容器文件本身維持登入後存取。
    match /brands/{brandId} {
      allow read, write: if signedIn();
    }

    match /artifacts/{appId} {
      allow read, write: if signedIn();
    }

    match /artifacts/{appId}/public/{publicDoc} {
      allow read, write: if signedIn();
    }

    // 新品牌路徑：代理資料只能新增／更新，不允許刪除；歷史以 status=ended 保留。
    match /brands/{brandId}/management_delegations/{delegationId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validDelegation(request.resource.data);
      allow delete: if false;
    }

    // CYJ 舊版路徑。
    match /artifacts/{appId}/public/data/management_delegations/{delegationId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validDelegation(request.resource.data);
      allow delete: if false;
    }

    // 系統日誌禁止修改或刪除。
    match /brands/{brandId}/system_logs/{logId} {
      allow create, read: if signedIn();
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/system_logs/{logId} {
      allow create, read: if signedIn();
      allow update, delete: if false;
    }

    // Device Approval v1：裝置信任與核准結果一律由 Cloud Functions 寫入。
    // 前端只保留必要讀取，避免新裝置自行把自己改成「已信任」。
    match /brands/{brandId}/account_devices/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /brands/{brandId}/device_approval_requests/{requestId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /brands/{brandId}/device_approval_requests/{requestId}/private/{document=**} {
      allow read, write: if false;
    }

    match /brands/{brandId}/device_approval_inbox/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /brands/{brandId}/security_alerts/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /brands/{brandId}/security_summary/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/account_devices/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/device_approval_requests/{requestId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/device_approval_requests/{requestId}/private/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/public/data/device_approval_inbox/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/security_alerts/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/security_summary/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/global_blocked_devices/{document=**} {
      allow read, write: if false;
    }

    // 既有品牌資料維持原本登入後可讀寫；排除上方受保護集合，避免寬鬆規則覆蓋。
    match /brands/{brandId}/{collectionName}/{document=**} {
      allow read, write: if signedIn()
        && collectionName != 'management_delegations'
        && collectionName != 'system_logs'
        && collectionName != 'account_devices'
        && collectionName != 'device_approval_requests'
        && collectionName != 'device_approval_inbox'
        && collectionName != 'security_alerts'
        && collectionName != 'security_summary';
    }

    match /artifacts/{appId}/public/data/{collectionName}/{document=**} {
      allow read, write: if signedIn()
        && collectionName != 'management_delegations'
        && collectionName != 'system_logs'
        && collectionName != 'account_devices'
        && collectionName != 'device_approval_requests'
        && collectionName != 'device_approval_inbox'
        && collectionName != 'security_alerts'
        && collectionName != 'security_summary'
        && collectionName != 'global_blocked_devices';
    }

    // 其他既有根集合維持登入後存取；brands / artifacts 已由上方專屬規則處理。
    match /{topLevel}/{document=**} {
      allow read, write: if signedIn()
        && topLevel != 'brands'
        && topLevel != 'artifacts';
    }
  }
}
