rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // P0-FINAL-1C-2：Firebase Auth ready 不再等於 SaaS 資料權限。
    // 正式營運資料必須使用 Backend 核發的 Application Identity Custom Claims。
    function applicationIdentity() {
      return signedIn()
        && request.auth.token.drcyjIdentity == true
        && request.auth.token.identityVersion == 'application-identity-v1'
        && request.auth.token.brandId in ['cyj', 'anniu', 'yibo']
        && request.auth.token.roleId in ['director', 'trainer', 'manager', 'store', 'therapist']
        && request.auth.token.accountId is string
        && request.auth.token.accountId.size() > 0;
    }

    function sameBrandIdentity(brandId) {
      return applicationIdentity()
        && request.auth.token.brandId == brandId;
    }

    function cyjApplicationIdentity() {
      return applicationIdentity()
        && request.auth.token.brandId == 'cyj';
    }

    function cyjLegacyIdentity(appId) {
      return appId == 'default-app-id'
        && cyjApplicationIdentity();
    }

    // 登入畫面使用 Firebase anonymous auth 作為極小 bootstrap surface。
    function anonymousBootstrap() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Pending device request 在 Custom Token 建立前只能由「建立這筆 request 的 anonymous UID」讀取。
    // Custom Token 建立後則回到同品牌 Application Identity 規則。
    function ownsBootstrapDeviceRequest() {
      return signedIn()
        && resource.data.bootstrapAuthUid is string
        && resource.data.bootstrapAuthUid.size() > 0
        && resource.data.bootstrapAuthUid == request.auth.uid;
    }

    // 目前專案採匿名登入／自訂 Token 混合架構，因此 Rules 先負責：
    // 1. 代理資料結構驗證；2. 禁止硬刪；3. 禁止代理取得正式組織修改權限。
    // 真正的職級不可只信任前端欄位；日後若改用 Custom Claims，可再把 director/master 改為伺服器身分驗證。
    function validDelegation(data) {
      return data.keys().hasAll([
          'schemaVersion', 'type', 'principalRole', 'principalId', 'principalName',
          'delegateRole', 'delegateId', 'delegateName', 'scopeMode', 'storeNames',
          'principalStoreSnapshot', 'startDate', 'endDate', 'status', 'permissions',
          'updatedByRole'
        ])
        && data.schemaVersion == 'delegation-v1'
        && data.type in ['regional_manager', 'store_manager']
        && data.principalRole in ['manager', 'store']
        && data.delegateRole == data.principalRole
        && data.principalId is string
        && data.principalName is string
        && data.delegateId is string
        && data.delegateName is string
        && data.principalId.size() > 0
        && data.delegateId.size() > 0
        && data.principalId != data.delegateId
        && data.scopeMode in ['all_assigned_stores', 'selected_stores']
        && data.storeNames is list
        && (data.scopeMode != 'selected_stores' || data.storeNames.size() > 0)
        && data.principalStoreSnapshot is list
        && data.startDate is string
        && data.endDate is string
        && data.startDate.size() == 10
        && data.endDate.size() == 10
        && data.startDate <= data.endDate
        && data.status in ['active', 'scheduled', 'ended', 'cancelled']
        && data.permissions is map
        && data.permissions.keys().hasAll([
          'viewOperations', 'editReports', 'editHistory', 'deleteReports',
          'receiveAlerts', 'manageTasks', 'editTargets', 'editOrganization'
        ])
        && data.permissions.viewOperations is bool
        && data.permissions.editReports is bool
        && data.permissions.editHistory is bool
        && data.permissions.deleteReports is bool
        && data.permissions.receiveAlerts is bool
        && data.permissions.manageTasks is bool
        && data.permissions.editTargets is bool
        && data.permissions.editOrganization is bool
        && data.permissions.editOrganization == false
        && data.updatedByRole in ['director', 'master'];
    }

    // 品牌容器也必須綁定正式 Application Identity；不能由 anonymous bootstrap 穿透。
    match /brands/{brandId} {
      allow read, write: if sameBrandIdentity(brandId);
    }

    match /artifacts/{appId} {
      allow read, write: if cyjLegacyIdentity(appId);
    }

    match /artifacts/{appId}/public/{publicDoc} {
      allow read, write: if cyjLegacyIdentity(appId);
    }

    // P0-FINAL-1D-A2-2：代理與托管由 Backend authority 單一寫入。
    // Browser 僅保留同品牌讀取；create / update / delete 全部封鎖。
    match /brands/{brandId}/management_delegations/{delegationId} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    // CYJ legacy path：同樣只讀，寫入僅由 Admin SDK Backend authority 執行。
    match /artifacts/{appId}/public/data/management_delegations/{delegationId} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Delegation authority state 是跨文件 race/OCC 的 Backend-only serialization state。
    // Browser 不需要讀取，也不得偽造 revision / lock state。
    match /brands/{brandId}/management_delegation_authority/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/public/data/management_delegation_authority/{document=**} {
      allow read, write: if false;
    }

    // 系統日誌禁止修改或刪除。
    match /brands/{brandId}/system_logs/{logId} {
      allow create, read: if sameBrandIdentity(brandId);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/public/data/system_logs/{logId} {
      allow create, read: if cyjLegacyIdentity(appId);
      allow update, delete: if false;
    }

    // Device Approval v1：裝置信任與核准結果一律由 Cloud Functions 寫入。
    // 前端只保留必要讀取，避免新裝置自行把自己改成「已信任」。
    match /brands/{brandId}/account_devices/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /brands/{brandId}/device_approval_requests/{requestId} {
      allow read: if sameBrandIdentity(brandId) || ownsBootstrapDeviceRequest();
      allow write: if false;
    }

    match /brands/{brandId}/device_approval_requests/{requestId}/private/{document=**} {
      allow read, write: if false;
    }

    match /brands/{brandId}/device_approval_inbox/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /brands/{brandId}/security_alerts/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /brands/{brandId}/security_summary/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /brands/{brandId}/login_security_state/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/public/data/account_devices/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/device_approval_requests/{requestId} {
      allow read: if cyjLegacyIdentity(appId) || (appId == 'default-app-id' && ownsBootstrapDeviceRequest());
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/device_approval_requests/{requestId}/private/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/public/data/device_approval_inbox/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/security_alerts/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/security_summary/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/login_security_state/{document=**} {
      allow read, write: if false;
    }

    // Therapist Credential Separation v1：管理師密碼實體與人員主檔分離。
    // 此集合永遠不允許 Browser 直接讀寫；登入與改密碼僅能經 Backend authority。
    match /brands/{brandId}/therapist_credentials/{document=**} {
      allow read, write: if false;
    }

    match /artifacts/{appId}/public/data/therapist_credentials/{document=**} {
      allow read, write: if false;
    }

    // Therapist Master v1：人員主檔可供已登入畫面讀取，但 Browser 不得直接修改。
    // 新增／修改／封存／還原／刪除一律經 manageTherapistMaster Backend authority。
    match /brands/{brandId}/therapists/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/therapists/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Login Directory Summary v1：僅保存 sanitized 登入名單，不含 password / secret / token。
    // Browser 只讀；所有更新由 Backend Firestore triggers 維護。
    match /brands/{brandId}/login_directory_summary/{document=**} {
      allow read: if anonymousBootstrap() || sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/login_directory_summary/{document=**} {
      allow read: if (appId == 'default-app-id' && anonymousBootstrap()) || cyjLegacyIdentity(appId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/global_blocked_devices/{document=**} {
      allow read, write: if false;
    }

    // Store Lifecycle v1：正式 KPI eligibility Master。
    // 前端只允許登入後讀取；所有寫入必須經過 Backend 的最高管理者再驗證與 transaction。
    match /brands/{brandId}/store_lifecycle/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/store_lifecycle/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Login Security Telegram / Master Credential 設定屬 CYJ legacy Security authority。
    // system_version 是全 App bootstrap metadata：anonymous 與任一正式 Application Identity 可讀。
    // P0-FINAL-1D-A1 起，system_version / security_config / feature_flags / kpi_targets
    // 的 Browser write 全數封鎖，改由最高管理者 Backend authority 寫入。
    // 其他 CYJ global_settings 必須是 CYJ Application Identity。
    match /artifacts/{appId}/public/data/global_settings/{settingId} {
      allow read: if appId == 'default-app-id' && (
        (settingId == 'system_version' && (anonymousBootstrap() || applicationIdentity()))
        || (
          settingId != 'system_version'
          && cyjApplicationIdentity()
          && settingId != 'master_auth'
          && settingId != 'director_auth'
          && settingId != 'trainer_auth'
          && settingId != 'manager_auth'
          && settingId != 'store_account_data'
        )
      );
      allow write: if appId == 'default-app-id'
        && cyjApplicationIdentity()
        && settingId != 'system_version'
        && settingId != 'security_config'
        && settingId != 'feature_flags'
        && settingId != 'kpi_targets'
        && settingId != 'org_structure'
        && settingId != 'telegram_security_alerts'
        && settingId != 'audit_exclusions'
        && settingId != 'permissions'
        && settingId != 'master_auth'
        && settingId != 'director_auth'
        && settingId != 'trainer_auth'
        && settingId != 'manager_auth'
        && settingId != 'store_account_data';
    }

    // P0-FINAL-1D-A2-1：正式組織架構 Browser 只讀。
    // 新增／移動／刪除店家、區長調整與快照還原全部經 manageManagerOrganization。
    match /brands/{brandId}/settings/org_structure {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/global_settings/org_structure {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // 組織架構快照已成為 Backend restore authority 的輸入，因此 Browser 不得偽造或覆寫。
    match /brands/{brandId}/org_structure_snapshots/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/org_structure_snapshots/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Admin Credential Writer Retirement：所有含登入密碼的設定文件改由 Backend authority 存取。
    // Browser 不得直接讀取或寫入，避免帳號管理頁重新 hydration 整批 credential。
    match /brands/{brandId}/settings/director_auth {
      allow read, write: if false;
    }

    match /brands/{brandId}/settings/trainer_auth {
      allow read, write: if false;
    }

    match /brands/{brandId}/settings/manager_auth {
      allow read, write: if false;
    }

    match /brands/{brandId}/settings/store_account_data {
      allow read, write: if false;
    }

    // Module Permissions v1：模組權限為 Security authority。
    // 前端只讀；所有修改必須經 Backend 的最高管理者、Trusted Device、credential 與 revision OCC。
    match /brands/{brandId}/settings/permissions {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    // 最高管理金鑰：Browser 永遠不可讀寫，登入／頁面解鎖／變更一律經 Backend authority。
    match /brands/{brandId}/settings/master_auth {
      allow read, write: if false;
    }

    // System Exclusion v1：正式營運 scope authority。
    // 前端只讀；所有修改必須經 Backend 的最高管理者、Trusted Device、credential 與 revision OCC。
    match /brands/{brandId}/settings/audit_exclusions {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    // P0-FINAL-1D-A1：高階管理設定只允許 Browser read；writer 由 Backend authority 執行。
    match /brands/{brandId}/settings/security_config {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /brands/{brandId}/settings/feature_flags {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /brands/{brandId}/settings/kpi_targets {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/global_settings/audit_exclusions {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Projection Model v1：Backend-only derived authority。
    // 前端僅登入後讀取；所有寫入由 Functions Admin SDK 執行。
    match /brands/{brandId}/projection_models/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/projection_models/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }


    // Projection Accuracy v1：Backend-only checkpoint evidence。
    // 前端僅登入後讀取；checkpoint / finalizer 寫入一律由 Functions Admin SDK 執行。
    match /brands/{brandId}/projection_accuracy/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/projection_accuracy/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Projection Accuracy History v1：Backend-only 年度輕量比較摘要。
    // 僅保存已完成且可同口徑比較的月份；前端登入後唯讀。
    match /brands/{brandId}/projection_accuracy_history/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/projection_accuracy_history/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // Smart Forecast B3B Projection Context：營運情境 authority。
    // 前端登入後只讀；所有寫入由最高管理者安全 Backend writer 執行。
    match /brands/{brandId}/projection_context/{document=**} {
      allow read: if sameBrandIdentity(brandId);
      allow write: if false;
    }

    match /artifacts/{appId}/public/data/projection_context/{document=**} {
      allow read: if cyjLegacyIdentity(appId);
      allow write: if false;
    }

    // 既有品牌 settings 相容 surface：以第一層 settingId 判斷，避免 recursive wildcard
    // path 與字串比較造成受保護設定被寬鬆 fallback 意外放行。
    match /brands/{brandId}/settings/{settingId}/{document=**} {
      allow read, write: if sameBrandIdentity(brandId)
        && settingId != 'audit_exclusions'
        && settingId != 'permissions'
        && settingId != 'security_config'
        && settingId != 'feature_flags'
        && settingId != 'kpi_targets'
        && settingId != 'org_structure'
        && settingId != 'master_auth'
        && settingId != 'director_auth'
        && settingId != 'trainer_auth'
        && settingId != 'manager_auth'
        && settingId != 'store_account_data';
    }

    // 其他既有品牌資料維持原本登入後可讀寫；settings 整個 collection 由上方專用規則接管。
    match /brands/{brandId}/{collectionName}/{document=**} {
      allow read, write: if sameBrandIdentity(brandId)
        && collectionName != 'management_delegations'
        && collectionName != 'management_delegation_authority'
        && collectionName != 'org_structure_snapshots'
        && collectionName != 'system_logs'
        && collectionName != 'account_devices'
        && collectionName != 'device_approval_requests'
        && collectionName != 'device_approval_inbox'
        && collectionName != 'security_alerts'
        && collectionName != 'security_summary'
        && collectionName != 'login_security_state'
        && collectionName != 'therapist_credentials'
        && collectionName != 'therapists'
        && collectionName != 'login_directory_summary'
        && collectionName != 'store_lifecycle'
        && collectionName != 'projection_models'
        && collectionName != 'projection_accuracy'
        && collectionName != 'projection_accuracy_history'
        && collectionName != 'projection_context'
        && collectionName != 'settings';
    }

    match /artifacts/{appId}/public/data/{collectionName}/{document=**} {
      allow read, write: if cyjLegacyIdentity(appId)
        && collectionName != 'management_delegations'
        && collectionName != 'management_delegation_authority'
        && collectionName != 'org_structure_snapshots'
        && collectionName != 'system_logs'
        && collectionName != 'account_devices'
        && collectionName != 'device_approval_requests'
        && collectionName != 'device_approval_inbox'
        && collectionName != 'security_alerts'
        && collectionName != 'security_summary'
        && collectionName != 'login_security_state'
        && collectionName != 'therapist_credentials'
        && collectionName != 'therapists'
        && collectionName != 'login_directory_summary'
        && collectionName != 'global_blocked_devices'
        && collectionName != 'store_lifecycle'
        && collectionName != 'projection_models'
        && collectionName != 'projection_accuracy'
        && collectionName != 'projection_accuracy_history'
        && collectionName != 'projection_context'
        && collectionName != 'global_settings';
    }

    // 其他既有根集合屬全域相容 surface：至少必須是正式 Application Identity。
    // 更細的角色／writer authority 收斂留在 P0-FINAL-1D。
    match /{topLevel}/{document=**} {
      allow read, write: if applicationIdentity()
        && topLevel != 'brands'
        && topLevel != 'artifacts';
    }
  }
}
